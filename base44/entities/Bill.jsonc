{
  "name": "Bill",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "enum": [
        "Fisher's Enterprise",
        "Pencroft Structures"
      ],
      "default": "Fisher's Enterprise",
      "description": "Company this bill belongs to"
    },
    "vendor": {
      "type": "string",
      "description": "Vendor or supplier name"
    },
    "bill_date": {
      "type": "string",
      "format": "date",
      "description": "Date of the bill"
    },
    "bill_number": {
      "type": "string",
      "description": "Vendor's invoice number"
    },
    "category": {
      "type": "string",
      "enum": [
        "fuel",
        "maintenance",
        "repairs",
        "insurance",
        "registration",
        "tolls",
        "other"
      ],
      "default": "maintenance",
      "description": "Expense category"
    },
    "line_items": {
      "type": "array",
      "description": "Line items in the bill",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "vehicle_id": {
            "type": "string",
            "description": "Optional vehicle this line item applies to"
          },
          "item_id": {
            "type": "string",
            "description": "Optional stock item being purchased"
          },
          "item_quantity": {
            "type": "number",
            "description": "Quantity of stock item to add to inventory"
          }
        }
      }
    },
    "total_amount": {
      "type": "number",
      "description": "Total bill amount"
    },
    "photo_url": {
      "type": "string",
      "description": "URL of bill photo"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    }
  },
  "required": [
    "vendor",
    "bill_date"
  ]
}