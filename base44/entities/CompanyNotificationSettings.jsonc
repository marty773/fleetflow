{
  "name": "CompanyNotificationSettings",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "enum": [
        "Fisher's Enterprise",
        "Pencroft Structures"
      ],
      "description": "Company this setting belongs to"
    },
    "bill_notification_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Send email when a new bill is created"
    },
    "bill_notification_email": {
      "type": "string",
      "description": "Email address to send bill notifications to"
    }
  },
  "required": [
    "company_id"
  ]
}